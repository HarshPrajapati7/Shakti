{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sakti",
  "version": "1.0.0",
  "identifier": "org.starbusters.sakti",
  "build": {
    "frontendDist": "../../apps/web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Sakti",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#17181b"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Team Star Busters",
    "shortDescription": "Astronaut health self-assessment",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
